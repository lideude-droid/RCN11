# Discord OAuth (Discord Developer Portal > Tua App > OAuth2)
DISCORD_CLIENT_ID=1508553666389475378
DISCORD_CLIENT_SECRET=cole_aqui_o_teu_client_secret
# tem de ser EXATAMENTE igual ao URL do teu serviço no Render, com "/" no fim
REDIRECT_URI=https://o-teu-servico.onrender.com/

# Supabase (Supabase > Project Settings > API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# usa a "service_role" key (não a "anon"), porque o servidor escreve na tabela posts
SUPABASE_SERVICE_KEY=cole_aqui_a_tua_service_role_key

PORT=3000
